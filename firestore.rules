rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ✅ FUNCIÓN AUXILIAR: Verifica si el usuario autenticado es administrador
    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 1. Perfiles de paseadores
    match /walker_profiles/{profileId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == profileId || isAdmin());
    }

    // 2. Usuarios
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // 3. Mascotas
    match /pets/{petId} {
      allow read, write: if request.auth != null;
    }

    // 4. Paseos
    match /walks/{walkId} {
      // El dueño puede hacer CUALQUIER cosa con sus propios paseos
      allow read, write: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // El paseador asignado puede leer y actualizar
      allow read, update: if request.auth != null && resource.data.walkerId == request.auth.uid;

      // Cualquier paseador puede aceptar un paseo pendiente
      allow update: if request.auth != null &&
                    (resource.data.status == 'pending' || resource.data.status == 'paid') &&
                    request.resource.data.walkerId == request.auth.uid &&
                    request.resource.data.status == 'accepted';

      // Solo el dueño puede crear un nuevo paseo
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;

      // ✅ NUEVO: Cualquier usuario autenticado puede LEER solicitudes
      // pendientes/pagadas. Sin esta regla, la pantalla "Solicitudes
      // Disponibles" del paseador fallaba con permission-denied, porque
      // un paseo pendiente todavía no tiene walkerId asignado.
      allow read: if request.auth != null &&
                    (resource.data.status == 'pending' || resource.data.status == 'paid');

      // ✅ El admin puede leer y actualizar cualquier paseo
      allow read, update: if isAdmin();
    }

    // 5. CHATS
    match /chats/{chatId} {
      allow read, write: if request.auth != null;

      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // 6. LLAMADAS (✅ CORREGIDO: ahora incluye las subcolecciones de candidatos ICE)
    // Sin estas sub-reglas, WebRTC no puede intercambiar los candidatos ICE
    // y las llamadas/videollamadas NUNCA conectan.
    match /calls/{callId} {
      allow read, write: if request.auth != null;

      // Candidatos ICE del que inicia la llamada
      match /callerCandidates/{candidateId} {
        allow read, write: if request.auth != null;
      }

      // Candidatos ICE del que responde la llamada
      match /calleeCandidates/{candidateId} {
        allow read, write: if request.auth != null;
      }
    }

    // 7. Tokens de admin
    match /admin_tokens/{tokenId} {
      allow read, write: if request.auth != null;
    }

    // 8. RESEÑAS Y CALIFICACIONES
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.reviewerId == request.auth.uid;
    }

    // 9. Registros de actividad
    match /activity_logs/{logId} {
      allow read: if request.auth != null;
      allow write: if false; // Solo el backend/Cloud Functions deberían escribir aquí
    }

    // 10. CONFIGURACIÓN DEL SISTEMA
    match /settings/{documentId} {
      // ✅ allow read: if true; permite que la app cargue los precios al inicio SIN estar logueada
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. BILLETERAS DE PASEADORES
    match /wallets/{walkerId} {
      allow read, write: if request.auth != null && request.auth.uid == walkerId;
      allow read: if isAdmin();
    }

    // 12. HEATMAP DE DEMANDA (✅ CORREGIDO)
    // La app escribe un punto {lat, lng, createdAt} cada vez que se crea un paseo.
    // Con "allow write: if false" la escritura era rechazada y el mapa quedaba vacío.
    match /walk_requests_heatmap/{docId} {
      // Lectura pública para que los paseadores vean la demanda
      allow read: if true;
      // ✅ Solo usuarios autenticados pueden CREAR puntos de demanda.
      // Nadie puede modificar ni borrar puntos existentes desde la app.
      allow create: if request.auth != null;
      allow update, delete: if false; // Solo Cloud Functions (Admin SDK) pueden limpiar/modificar
    }
  }
}
